# Copy this file to .env (same folder) and fill in your Supabase values.
# .env is ignored by git, so your keys never reach GitHub. Each computer needs its own .env.
# Find the values in Supabase: Project Settings -> API (and Data API).

# The game server (npm run server). The service role key is SECRET: it can change any data.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here

# The browser (npm run dev): the same URL and the public anon key (safe to show in a browser).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=paste-the-anon-public-key-here
